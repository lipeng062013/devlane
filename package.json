{
  "name": "devlane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "dev:server": "node scripts/build.mjs --server-only && node dist/server.mjs",
    "dev:web": "npm run dev -w @devlane/web",
    "start": "node dist/server.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "sql.js": "^1.15.2"
  }
}
