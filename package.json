{
  "name": "devlane",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs --open",
    "pack": "node scripts/pack.mjs",
    "dev": "node scripts/build.mjs --server-only && node dist/server.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
